# Express API server (reference copy; canonical example: ../.env.example)
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Gemini: backend secret only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
GEMINI_TIMEOUT_MS=30000

# Firebase Admin: use separate fields OR service-account JSON OR ADC
FIREBASE_PROJECT_ID=ai-agents-da29a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
ADMIN_EMAIL=
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

# Optional Firebase Emulator Suite (local development only)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Bounded analysis
MAX_PAGES_PER_ANALYSIS=6
MAX_PAGE_BYTES=1000000
MAX_TOTAL_BYTES=3000000
FETCH_TIMEOUT_MS=10000
ANALYSIS_TIMEOUT_MS=90000
MAX_REDIRECTS=3
CACHE_TTL_SECONDS=86400